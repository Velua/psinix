# admin: your local age key (age-keygen, stored in ~/.config/sops/age/keys.txt)
# host:  derived from the server's SSH host key (after first NixOS boot):
#          ssh-keyscan -t ed25519 HOST | ssh-to-age
#        Uncomment &host below and under age: once you have that public key, then:
#          sops updatekeys secrets.yaml
keys:
  - &admin age1...   # from age-keygen → ~/.config/sops/age/keys.txt
  # - &host  age1...   # uncomment after: ssh-keyscan -t ed25519 HOST | ssh-to-age
creation_rules:
  - path_regex: secrets\.yaml$
    key_groups:
      - age:
          - *admin
          # - *host   # uncomment together with &host above
